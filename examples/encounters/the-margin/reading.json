  "blocks": [
    {
      "id": "p-0",
      "byte_start": 0,
      "byte_end": 99,
      "text": "春汛一过，渡口就摆起一张小桌。有人拎着鸡蛋来，有人带一把刚掐的葱。",
      "heading": false,
      "source_gap_before": "",
      "runs": [
        {
          "byte_start": 0,
          "byte_end": 99,
          "text": "春汛一过，渡口就摆起一张小桌。有人拎着鸡蛋来，有人带一把刚掐的葱。",
          "speaker_id": null,
          "take_id": null
        }
      ],
      "audio": []
    },
    {
      "id": "p-101",
      "byte_start": 101,
      "byte_end": 206,
      "text": "她替人写信，从不把最后一行写满。“你自己添个字，”她说，“歪也认得。”",
      "heading": false,
      "source_gap_before": "\n\n",
      "runs": [
        {
          "byte_start": 101,
          "byte_end": 206,
          "text": "她替人写信，从不把最后一行写满。“你自己添个字，”她说，“歪也认得。”",
          "speaker_id": null,
          "take_id": null
        }
      ],
      "audio": []
    },
    {
      "id": "p-208",
      "byte_start": 208,
      "byte_end": 304,
      "text": "入冬她收了摊。那张小桌摆在厨房里，少一条腿，底下垫着两册旧历书。",
      "heading": false,
      "source_gap_before": "\n\n",
      "runs": [
        {
          "byte_start": 208,
          "byte_end": 304,
          "text": "入冬她收了摊。那张小桌摆在厨房里，少一条腿，底下垫着两册旧历书。",
          "speaker_id": null,
          "take_id": null
        }
      ],
      "audio": []
    },
    {
      "id": "p-306",
      "byte_start": 306,
      "byte_end": 426,
      "text": "第二年开春，邮差送来一张明信片。正面是一座她没见过的桥，背面只写着：这回轮到我。",
      "heading": false,
      "source_gap_before": "\n\n",
      "runs": [
        {
          "byte_start": 306,
          "byte_end": 426,
          "text": "第二年开春，邮差送来一张明信片。正面是一座她没见过的桥，背面只写着：这回轮到我。",
          "speaker_id": null,
          "take_id": null
        }
      ],
      "audio": []
    },
    {
      "id": "p-428",
      "byte_start": 428,
      "byte_end": 527,
      "text": "她把铅笔削好，递给坐在对面的人。那人把明信片翻回来，轻轻推还给她。",
      "heading": false,
      "source_gap_before": "\n\n",
      "runs": [
        {
          "byte_start": 428,
          "byte_end": 527,
          "text": "她把铅笔削好，递给坐在对面的人。那人把明信片翻回来，轻轻推还给她。",
          "speaker_id": null,
          "take_id": null
        }
      ],
      "audio": []
    },
    {
      "id": "p-529",
      "byte_start": 529,
      "byte_end": 568,
      "text": "她在空着的地方画了一根葱。",
      "heading": false,
      "source_gap_before": "\n\n",
      "runs": [
        {
          "byte_start": 529,
          "byte_end": 568,
          "text": "她在空着的地方画了一根葱。",
          "speaker_id": null,
          "take_id": null
        }
      ],
