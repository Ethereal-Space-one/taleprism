# Copy to .env. This file is read as data, not executed by a shell.
# Offline reading, manual editing and content-pack import require no keys.
STORYGAL_LLM_API_KEY=
STORYGAL_LLM_BASE_URL=https://api.deepseek.com
STORYGAL_LLM_MODEL=deepseek-flash
# Optional cloud speech. Leave blank until you have your own account.
OPENAI_API_KEY=
# Optional absolute directory for projects. Default: ./data
# STORYGAL_DATA_DIR=/absolute/path/to/storygal-data
# Port is read by run.sh / the launcher from your shell environment.
# export STORYGAL_PORT=8000
